pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        NODE_ENV       = 'test'
        BACKEND_IMAGE  = "blog-platform-backend:latest"
        FRONTEND_IMAGE = "blog-platform-frontend:latest"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
                sh 'git log --oneline -5'
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('Backend Deps') {
                    steps {
                        echo 'Installing backend dependencies...'
                        dir('blog-platform/server') {
                            sh 'npm install --legacy-peer-deps'
                        }
                    }
                }
                stage('Frontend Deps') {
                    steps {
                        echo 'Installing frontend dependencies...'
                        dir('blog-platform/client') {
                            sh 'npm install --legacy-peer-deps'
                        }
                    }
                }
            }
        }

        stage('Backend Tests') {
            environment {
                NODE_ENV       = 'test'
                JWT_SECRET     = 'ci_test_jwt_secret_key_not_for_production'
                MONGO_URI_TEST = 'mongodb://localhost:27017/blogplatform_ci_test'
            }
            steps {
                echo 'Running backend test suite...'
                dir('blog-platform/server') {
                    sh 'npm test -- --forceExit'
                }
            }
        }

        stage('Frontend Build') {
            steps {
                echo 'Building React production bundle...'
                dir('blog-platform/client') {
                    sh 'npm run build'
                    sh 'ls -la build/'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker images...'
                script {
                    sh 'docker build -t blog-platform-backend:latest ./blog-platform/server'
                    sh 'docker build -t blog-platform-frontend:latest ./blog-platform/client'
                    sh 'docker images | grep blog-platform'
                }
            }
        }

        stage('Compose Validate') {
            steps {
                echo 'Validating Docker Compose configuration...'
                dir('blog-platform') {
                    sh 'docker compose config --quiet'
                }
                echo 'Docker Compose configuration is valid.'
            }
        }

        stage('Deploy to EC2') {
            steps {
                echo 'Deploying to EC2...'
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    file(credentialsId: 'blog-platform-env', variable: 'ENV_FILE')
                ]) {
                    script {
                        def ec2Host = env.EC2_HOST
                        def appDir  = env.APP_DIR ?: '/opt/blog-platform/blog-platform'
                        def sshOpts = '-o StrictHostKeyChecking=no -o ConnectTimeout=30'
                        sh "scp ${sshOpts} -i ${SSH_KEY} ${ENV_FILE} ${SSH_USER}@${ec2Host}:${appDir}/.env"
                        sh "ssh ${sshOpts} -i ${SSH_KEY} ${SSH_USER}@${ec2Host} 'set -e && cd ${appDir} && git pull origin main && docker compose build --no-cache && docker compose down --remove-orphans && docker compose up -d && docker image prune -f && docker compose ps'"
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                echo 'Running post-deploy health check...'
                script {
                    def ec2Host = env.EC2_HOST
                    retry(5) {
                        sleep(time: 15, unit: 'SECONDS')
                        sh "curl -f --silent --max-time 10 http://${ec2Host}/api/blogs || exit 1"
                    }
                }
                echo 'Application is healthy!'
            }
        }
    }

    post {
        success { echo 'Pipeline succeeded!' }
        failure { echo 'Pipeline failed.' }
        always { cleanWs() }
    }
}